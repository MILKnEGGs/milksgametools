# Cloudflare Pages headers. The service worker and HTML must always be revalidated so
# updates are noticed; hashed files under /assets can be cached forever.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
